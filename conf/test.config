/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests  --  DISABLED
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    -profile test is disabled: there is no small test dataset with direct download links
    yet. The pipeline stops with an error when this profile is used
    (see validateInputParameters() in subworkflows/local/utils_nfcore_sequencingqc_pipeline).

    Use -profile test_seqc2 instead (SEQC2 data, downloaded once with
    scripts/download_seqc2_testdata.py, see docs/usage.md).
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile (disabled)'
    config_profile_description = 'Disabled: no test data with direct links yet. Use -profile test_seqc2.'
}
