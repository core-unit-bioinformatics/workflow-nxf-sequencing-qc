/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Uses the synthetic fingerprint data in tests/fixtures/fingerprint/ (no real
    sequence or patient data): run B with four samples, one of them without BAM
    (aligned with bwa-mem2), checked against the fingerprint database of run A.
    FastQ Screen and the DRAGEN CNV QC need real databases / DRAGEN output and
    are switched off.

    The samplesheet uses paths relative to the repository root, so launch the
    test profile from there:
        nextflow run . -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // the synthetic data is tiny; these limits also fit small CI runners
    resourceLimits = [
        cpus: 2,
        memory: '2.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic fingerprint test data (tests/fixtures/fingerprint)'

    // Input data
    input          = "${projectDir}/tests/fixtures/fingerprint/samplesheet_test.csv"
    multiqc_inputs = "${projectDir}/tests/fixtures/fingerprint/multiqc_inputs_test.csv"

    // Fingerprint check against the database of run A, aligning samples without BAM
    enable_fingerprintcheck     = true
    fingerprint_haplotype_map   = "${projectDir}/tests/fixtures/fingerprint/haplotype_map.txt"
    fasta                       = "${projectDir}/tests/fixtures/fingerprint/reference.fasta"
    fingerprint_database        = "${projectDir}/tests/fixtures/fingerprint/report/previous_database.vcf.gz"
    align_reads_for_fingerprint = true

    // need real databases / DRAGEN output
    enable_fastqscreen = false
    enable_cnvqc       = false
}
