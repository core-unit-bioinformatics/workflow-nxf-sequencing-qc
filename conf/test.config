/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Test data: SEQC2 reference samples HCC1395 (tumor) and HCC1395BL (matched normal),
    one pair each for gene panel (AmpliSeq), exome (WES) and genome (WGS), sliced to
    chr2:29700000-29740000 (ALK, GRCh38). Also contains a FastQ Screen database
    (human slice + PhiX, .tar.gz) and a haplotype map of common 1000 Genomes SNPs.
    How the data were made: 'seqc2/README.md' on the 'test-datasets' branch.

    CNV QC is switched off: it needs DRAGEN CNV output, which is not part of SEQC2.

    Use as follows:
        nextflow run core-unit-bioinformatics/exomeqc -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // the synthetic data is tiny; these limits also fit small CI runners
    resourceLimits = [
        cpus: 2,
        memory: '2.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'SEQC2 HCC1395 tumor/normal (panel, exome, genome) slice to check pipeline function'

    // Input data
    input                     = "${params.pipelines_testdata_base_path}seqc2/samplesheet.csv"

    // FastQ Screen
    enable_fastqscreen        = true
    fastqscreen_database      = "${params.pipelines_testdata_base_path}seqc2/fastqscreen_db.tar.gz"

    // Fingerprint check
    enable_fingerprintcheck   = true
    fingerprint_haplotype_map = "${params.pipelines_testdata_base_path}seqc2/haplotype_map.txt"

    // DRAGEN CNV QC: no DRAGEN output in the test data
    enable_cnvqc              = false
}
