/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        // report file name <multiqc_report_name>.html; MultiQC's default name if unset
        ext.prefix = { params.multiqc_report_name ?: null }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PICARD_CROSSCHECKFINGERPRINTS' {
        ext.args = {
            [
                '--CROSSCHECK_BY FILE',
                '--CALCULATE_TUMOR_AWARE_RESULTS true',
                "--ALLOW_DUPLICATE_READS ${params.fingerprint_allow_duplicate_reads}",
                '--EXIT_CODE_WHEN_MISMATCH 0'
            ].join(' ').trim()
        }
        ext.prefix = 'crosscheck'
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQSCREEN_FASTQSCREEN' {
        ext.args = {
            [
                "--aligner bowtie2",
                "--paired",
                "--subset ${params.fastqscreen_subset}"
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastqscreen" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DRAGEN_CNV_QC' {
        ext.args = {
            [
                '--plot-purcov-maxmodel=false',
                params.pmad_max != null ? "--pmad_max \"$params.pmad_max\"" : '',
                params.coverage_mad_max != null ? "--coverage_mad_max \"$params.coverage_mad_max\"" : '',
                params.outlier_baf_fraction_max != null ? "--outlier_baf_fraction_max \"$params.outlier_baf_fraction_max\"" : '',
                params.diploid_coverage_min != null ? "--diploid_coverage_min \"$params.diploid_coverage_min\"" : '',
                params.purity_min != null ? "--purity_min \"$params.purity_min\"" : '',
                params.purity_max != null ? "--purity_max \"$params.purity_max\"" : '',
                params.ploidy_min != null ? "--ploidy_min \"$params.ploidy_min\"" : '',
                params.ploidy_max != null ? "--ploidy_max \"$params.ploidy_max\"" : '',
                params.post_norm_sigma_max != null ? "--post_norm_sigma_max \"$params.post_norm_sigma_max\"" : '',
                params.num_segments_max != null ? "--num_segments_max \"$params.num_segments_max\"" : '',
                params.filtered_records_relative_max != null ? "--filtered_records_relative_max \"$params.filtered_records_relative_max\"" : '',
                params.homozygosity_index_max != null ? "--homozygosity_index_max \"$params.homozygosity_index_max\"" : '',
                params.total_excluded_bp_max != null ? "--total_excluded_bp_max \"$params.total_excluded_bp_max\"" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/cnv-metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VAF_HISTOGRAM' {
        ext.args = {
            [
                "--allele-fraction ${params.vaf_histogram_allele_fraction}",
                "--bin-width ${params.vaf_histogram_bin_width}",
                params.vaf_histogram_sample_regex != null ? "--sample-regex='${params.vaf_histogram_sample_regex}'" : '',
                params.vaf_histogram_include_filtered ? '--include-filtered' : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/vaf-histogram" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
