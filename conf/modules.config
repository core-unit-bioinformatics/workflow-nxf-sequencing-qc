/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        // report file name <multiqc_report_name>.html; MultiQC's default name if unset
        ext.prefix = { params.multiqc_report_name ?: null }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PICARD_CROSSCHECKFINGERPRINTS' {
        ext.args = {
            [
                '--CROSSCHECK_BY FILE',
                '--CALCULATE_TUMOR_AWARE_RESULTS true',
                "--ALLOW_DUPLICATE_READS ${params.fingerprint_allow_duplicate_reads}",
                '--EXIT_CODE_WHEN_MISMATCH 0'
            ].join(' ').trim()
        }
        ext.prefix = 'crosscheck'
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PICARD_EXTRACTFINGERPRINT' {
        // the VCF sample name is the fingerprint ID <sample>@<runid>
        ext.args = { "--SAMPLE_ALIAS '${meta.fingerprint_id}' --CREATE_INDEX true" }
        // unpublished: the fingerprint after QC (BCFTOOLS_ANNOTATE_FINGERPRINT_QC) is published
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint_raw" }
        publishDir = [ enabled: false ]
    }

    // -------------------------------------------------------------------------
    // Fingerprint QC
    // -------------------------------------------------------------------------
    withName: 'GAWK_FINGERPRINT_SITES' {
        // BED of all SNPs of the haplotype map (header lines start with @ or #)
        ext.args2 = '\'BEGIN { OFS = "\\t" } !/^[@#]/ && NF { print \$1, \$2 - 1, \$2 }\''
        ext.prefix = 'haplotype_map_sites'
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_MPILEUP_FINGERPRINT' {
        // all bases with their base and mapping quality and read name: the
        // thresholds are applied by fingerprint_qc.py; no BAQ, no overlap
        // removal (each read name counts once there), no depth limit
        ext.args = {
            [
                '--no-BAQ',
                '--min-BQ 0',
                '--min-MQ 0',
                '--output-MQ',
                '--output-QNAME',
                '--ignore-overlaps-removal',
                '--max-depth 0',
                params.fingerprint_allow_duplicate_reads ? '--ff UNMAP,SECONDARY,QCFAIL' : '--ff UNMAP,SECONDARY,QCFAIL,DUP'
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint_sites" }
        publishDir = [ enabled: false ]
    }

    withName: 'FINGERPRINT_QC' {
        ext.args = {
            [
                "--min-base-quality ${params.fingerprint_qc_min_base_quality}",
                "--min-mapping-quality ${params.fingerprint_qc_min_mapping_quality}",
                "--min-site-depth ${params.fingerprint_qc_min_site_depth}",
                "--min-site-mean-base-quality ${params.fingerprint_qc_min_site_mean_base_quality}",
                "--min-fraction-passing-sites ${params.fingerprint_qc_min_fraction_passing_sites}",
                // contamination check only on request (not suited for tumour samples)
                params.fingerprint_qc_contamination_check ? "--max-contamination ${params.fingerprint_qc_max_contamination}" : '',
                "--qc-date ${workflow.start.format(java.time.format.DateTimeFormatter.ISO_LOCAL_DATE)}",
                "--sequencingqc-version ${workflow.manifest.version}"
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint_qc" }
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/qc" },
            mode: params.publish_dir_mode,
            // the header lines go into the fingerprint VCF
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_header.txt') ? null : filename }
        ]
    }

    withName: 'HTSLIB_BGZIPTABIX_FINGERPRINT_QC' {
        // tabix index of the QC site table (#CHROM header line, POS in column 2)
        ext.args2 = '-s 1 -b 2 -e 2'
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint_qc_sites.tsv" }
        publishDir = [ enabled: false ]
    }

    withName: 'BCFTOOLS_ANNOTATE_FINGERPRINT_QC' {
        // the columns of the site table written by fingerprint_qc.py
        ext.args = '--columns CHROM,POS,REF,ALT,FORMAT/FT,FORMAT/FPDP,FORMAT/FPAD,FORMAT/FPBQ,FORMAT/PL --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint" }
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/fingerprints" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECK_FINGERPRINT_DATABASE' {
        ext.prefix = 'previous_database'
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/database" },
            mode: params.publish_dir_mode,
            // the keep list is only an input of BCFTOOLS_VIEW_FINGERPRINT_DATABASE
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('_keep.txt') ? null : filename }
        ]
    }

    withName: 'BCFTOOLS_VIEW_FINGERPRINT_DATABASE' {
        // keep the fingerprints listed by CHECK_FINGERPRINT_DATABASE (--samples-file,
        // fails on a missing sample); write bgzip with a new tabix index
        ext.args = '--output-type z --write-index=tbi'
        ext.prefix = 'previous_database_kept'
        publishDir = [ enabled: false ]
    }

    withName: 'BCFTOOLS_MERGE_FINGERPRINT_DATABASE' {
        // --force-single: a run with one sample and no previous database has one input file
        ext.args = '--force-single --output-type z --write-index=tbi'
        // sequencingqc_fingerprint_database_<YYYYMMDD-hhmmss>, set in the subworkflow;
        // unpublished: the database with rewritten QC header lines is published
        ext.prefix = { "${meta.id}.merged" }
        publishDir = [ enabled: false ]
    }

    withName: 'FINGERPRINT_DATABASE_HEADER' {
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: 'BCFTOOLS_REHEADER_FINGERPRINT_DATABASE' {
        ext.args2 = '--output-type z --write-index=tbi'
        // sequencingqc_fingerprint_database_<YYYYMMDD-hhmmss>
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PICARD_CROSSCHECKFINGERPRINTS_DATABASE' {
        ext.args = {
            [
                '--CROSSCHECK_BY SAMPLE',
                '--CROSSCHECK_MODE CHECK_ALL_OTHERS',
                "--LOD_THRESHOLD ${params.fingerprint_database_lod_threshold}",
                '--EXIT_CODE_WHEN_MISMATCH 0'
            ].join(' ').trim()
        }
        ext.prefix = 'fingerprint_database'
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FINGERPRINT_DATABASE_REPORT' {
        ext.args = { "--lod-threshold ${params.fingerprint_database_lod_threshold}" }
        ext.prefix = 'fingerprint_database'
        publishDir = [
            path: { "${params.outdir}/fingerprintcheck/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BWAMEM2_MEM' {
        // -K: fixed batch size, so the alignment does not depend on the number of threads
        ext.args = { "-K 100000000 -R '@RG\\tID:${meta.id}_${meta.runid}\\tSM:${meta.id}\\tLB:${meta.id}_${meta.runid}\\tPL:ILLUMINA'" }
        ext.prefix = { "${meta.id}_${meta.runid}.aligned" }
        publishDir = [ enabled: false ]
    }

    withName: 'BWAMEM2_INDEX|SAMTOOLS_FAIDX|PICARD_CREATESEQUENCEDICTIONARY' {
        publishDir = [ enabled: false ]
    }

    withName: 'FASTQSCREEN_FASTQSCREEN' {
        ext.args = {
            [
                "--aligner bowtie2",
                meta.single_end ? '' : '--paired',
                "--subset ${params.fastqscreen_subset}"
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastqscreen" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DRAGEN_CNV_QC' {
        ext.args = {
            [
                '--plot-purcov-maxmodel=false',
                params.pmad_max != null ? "--pmad_max \"$params.pmad_max\"" : '',
                params.coverage_mad_max != null ? "--coverage_mad_max \"$params.coverage_mad_max\"" : '',
                params.outlier_baf_fraction_max != null ? "--outlier_baf_fraction_max \"$params.outlier_baf_fraction_max\"" : '',
                params.diploid_coverage_min != null ? "--diploid_coverage_min \"$params.diploid_coverage_min\"" : '',
                params.purity_min != null ? "--purity_min \"$params.purity_min\"" : '',
                params.purity_max != null ? "--purity_max \"$params.purity_max\"" : '',
                params.ploidy_min != null ? "--ploidy_min \"$params.ploidy_min\"" : '',
                params.ploidy_max != null ? "--ploidy_max \"$params.ploidy_max\"" : '',
                params.post_norm_sigma_max != null ? "--post_norm_sigma_max \"$params.post_norm_sigma_max\"" : '',
                params.num_segments_max != null ? "--num_segments_max \"$params.num_segments_max\"" : '',
                params.filtered_records_relative_max != null ? "--filtered_records_relative_max \"$params.filtered_records_relative_max\"" : '',
                params.homozygosity_index_max != null ? "--homozygosity_index_max \"$params.homozygosity_index_max\"" : '',
                params.total_excluded_bp_max != null ? "--total_excluded_bp_max \"$params.total_excluded_bp_max\"" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/cnv-metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VAF_HISTOGRAM' {
        ext.args = {
            [
                "--allele-fraction ${params.vaf_histogram_allele_fraction}",
                "--bin-width ${params.vaf_histogram_bin_width}",
                params.vaf_histogram_sample_regex != null ? "--sample-regex='${params.vaf_histogram_sample_regex}'" : '',
                params.vaf_histogram_include_filtered ? '--include-filtered' : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/vaf-histogram" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQUENCINGQC_SUMMARY' {
        ext.args = {
            [
                params.summary_tmb_high != null ? "--tmb-high ${params.summary_tmb_high}" : '',
                params.summary_msi_high != null ? "--msi-high ${params.summary_msi_high}" : '',
                params.summary_hrd_high != null ? "--hrd-high ${params.summary_hrd_high}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
