/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the SEQC2 test (-profile test_seqc2)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Test data: SEQC2 reference samples HCC1395 (tumor) and HCC1395BL (matched normal),
    one pair each for gene panel (AmpliSeq), exome (WES) and genome (WGS), sliced to
    chr2:29700000-29740000 (ALK, GRCh38) and moved onto a reference slice (the region
    +/- 1 kb as one contig, chr2_29699000_29741000). Also contains this reference slice
    (with .fai and .dict), a FastQ Screen database (human slice + PhiX, .tar.gz) and a
    haplotype map of common 1000 Genomes SNPs. The samplesheet has one made-up run ID
    per assay (SEQC2_PANEL, SEQC2_EXOME, SEQC2_GENOME).

    The data are NOT downloaded by Nextflow. Create them first (once, ~4 MB):
        conda env create -f scripts/envs/seqc2_testdata.yaml   # samtools, bcftools, bowtie2
        conda activate seqc2_testdata
        scripts/download_seqc2_testdata.py --outdir testdata
    The profile reads 'testdata/' relative to the launch directory; use
    --pipelines_testdata_base_path <dir>/ for another location.

    CNV QC is switched off: it needs DRAGEN CNV output, which is not part of SEQC2.

    Use as follows:
        nextflow run core-unit-bioinformatics/exomeqc -profile test_seqc2,<docker/singularity/conda> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    pipelines_testdata_base_path = 'testdata/'

    config_profile_name        = 'SEQC2 test profile'
    config_profile_description = 'SEQC2 HCC1395 tumor/normal (panel, exome, genome) slice to check pipeline function'

    // Input data
    input                     = "${params.pipelines_testdata_base_path}seqc2/samplesheet.csv"

    // FastQ Screen
    enable_fastqscreen        = true
    fastqscreen_database      = "${params.pipelines_testdata_base_path}seqc2/fastqscreen_db.tar.gz"

    // Fingerprint check
    enable_fingerprintcheck   = true
    fingerprint_haplotype_map = "${params.pipelines_testdata_base_path}seqc2/haplotype_map.txt"
    fasta                     = "${params.pipelines_testdata_base_path}seqc2/reference.fasta"
    fasta_fai                 = "${params.pipelines_testdata_base_path}seqc2/reference.fasta.fai"
    fasta_dict                = "${params.pipelines_testdata_base_path}seqc2/reference.dict"

    // DRAGEN CNV QC: no DRAGEN output in the test data
    enable_cnvqc              = false
}
