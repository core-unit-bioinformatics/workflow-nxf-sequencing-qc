nextflow_process {

    name "Test Process FINGERPRINT_DATABASE_REPORT"
    script "../main.nf"
    process "FINGERPRINT_DATABASE_REPORT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "fingerprint_database_report"

    // Synthetic fixtures, see tests/fixtures/fingerprint/make_fingerprint_fixtures.py:
    // run B (SYN001_3-N, SYN002_1-T, SYN003_1-T) against the database of run A.

    setup {
        run("CHECK_FINGERPRINT_DATABASE") {
            script "../../check_fingerprint_database/main.nf"
            process {
                """
                def check_fixtures = "${projectDir}/tests/fixtures/fingerprint"
                input[0] = [ [ id:'previous_database' ], file("\${check_fixtures}/report/previous_database.vcf.gz", checkIfExists: true) ]
                input[1] = file("\${check_fixtures}/haplotype_map.txt", checkIfExists: true)
                input[2] = file("\${check_fixtures}/report/run_fingerprint_ids.txt", checkIfExists: true)
                """
            }
        }
    }

    test("run B vs database of run A") {

        when {
            process {
                """
                def fixtures = "${projectDir}/tests/fixtures/fingerprint"
                def report = "\${fixtures}/report"
                def run_b = '20260201_LH00001_0002_BFIXTURE02'
                input[0] = CHECK_FINGERPRINT_DATABASE.out.check
                    .join(CHECK_FINGERPRINT_DATABASE.out.samples)
                    .map { _meta, check, samples ->
                        [
                            [ id:'fingerprint_database' ],
                            file("\${report}/run_samples.tsv", checkIfExists: true),
                            [ 'SYN001_3-N', 'SYN002_1-T', 'SYN003_1-T' ].collect { sample -> file("\${report}/\${sample}_\${run_b}.fingerprint.vcf.gz", checkIfExists: true) },
                            file("\${fixtures}/haplotype_map.txt", checkIfExists: true),
                            file("\${report}/crosscheck.crosscheck_metrics.txt", checkIfExists: true),
                            file("\${report}/database_qc.vcf.gz", checkIfExists: true),
                            check,
                            samples,
                            file("\${report}/fingerprint_database.crosscheck_metrics.txt", checkIfExists: true),
                            [ 'SYN001_3-N', 'SYN002_1-T', 'SYN003_1-T' ].collect { sample -> file("\${report}/qc/\${sample}_\${run_b}.fingerprint_qc_summary.tsv", checkIfExists: true) }
                        ]
                    }
                """
            }
        }

        then {
            def match_lines = path(process.out.matches[0][1]).readLines()
            def match_header = match_lines[0].split('\t') as List
            def matches = match_lines[1..-1].collect { line -> [ match_header, line.split('\t') as List ].transpose().collectEntries() }
            assertAll(
                { assert process.success },
                // the three classes of the fixture design are reported, unexpected results first
                { assert matches.collect { row -> row.status } == ['UNEXPECTED_MATCH', 'UNEXPECTED_MISMATCH', 'EXPECTED_MATCH'] },
                // this run passed the QC; run A was added to the database before the QC existed
                { assert matches.every { row -> row.fingerprint_qc == 'PASS' && row.database_fingerprint_qc == 'NOT_RECORDED' } },
                { assert path(process.out.fingerprints[0][1]).readLines()[1..-1].every { line -> line.endsWith('\tSUITABLE\tPASS') } },
                { assert path(process.out.qc[0][1]).readLines().size() == 4 },
                { assert file(process.out.qc_multiqc[0][1]).name == 'fingerprint_database_qc_mqc.tsv' },
                { assert path(process.out.overview[0][1]).text.contains('<strong>Fingerprint QC:</strong> 3 PASS, 0 FAIL') },
                { assert file(process.out.multiqc[0][1]).name == 'fingerprint_database_matches_mqc.tsv' },
                { assert path(process.out.overview[0][1]).text.contains('compared with 2 fingerprints of 1 other runs') },
                { assert snapshot(
                    process.out.matches,
                    process.out.fingerprints,
                    process.out.summary,
                    process.out.overview,
                    process.out.multiqc,
                    process.out.qc,
                    process.out.qc_multiqc,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("error - updated database without the database check") {

        when {
            process {
                """
                def fixtures = "${projectDir}/tests/fixtures/fingerprint"
                def report = "\${fixtures}/report"
                def run_b = '20260201_LH00001_0002_BFIXTURE02'
                // database.vcf.gz holds run A, which no database check accounts for
                input[0] = [
                    [ id:'fingerprint_database' ],
                    file("\${report}/run_samples.tsv", checkIfExists: true),
                    [ 'SYN001_3-N', 'SYN002_1-T', 'SYN003_1-T' ].collect { sample -> file("\${report}/\${sample}_\${run_b}.fingerprint.vcf.gz", checkIfExists: true) },
                    file("\${fixtures}/haplotype_map.txt", checkIfExists: true),
                    file("\${report}/crosscheck.crosscheck_metrics.txt", checkIfExists: true),
                    file("\${report}/database_qc.vcf.gz", checkIfExists: true),
                    [],
                    [],
                    [],
                    [ 'SYN001_3-N', 'SYN002_1-T', 'SYN003_1-T' ].collect { sample -> file("\${report}/qc/\${sample}_\${run_b}.fingerprint_qc_summary.tsv", checkIfExists: true) }
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.exitStatus == 1 },
                { assert (process.stdout + process.stderr).join('\n').contains('database content differs from the kept fingerprints + this run') }
            )
        }
    }

    test("run B vs database of run A - stub") {

        options "-stub"

        when {
            process {
                """
                def fixtures = "${projectDir}/tests/fixtures/fingerprint"
                def report = "\${fixtures}/report"
                input[0] = [
                    [ id:'fingerprint_database' ],
                    file("\${report}/run_samples.tsv", checkIfExists: true),
                    [ file("\${report}/SYN001_3-N_20260201_LH00001_0002_BFIXTURE02.fingerprint.vcf.gz", checkIfExists: true) ],
                    file("\${fixtures}/haplotype_map.txt", checkIfExists: true),
                    file("\${report}/crosscheck.crosscheck_metrics.txt", checkIfExists: true),
                    file("\${report}/database_qc.vcf.gz", checkIfExists: true),
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
