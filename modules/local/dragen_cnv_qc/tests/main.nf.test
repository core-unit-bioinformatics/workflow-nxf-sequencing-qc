nextflow_process {

    name "Test Process DRAGEN_CNV_QC"
    script "../main.nf"
    process "DRAGEN_CNV_QC"

    tag "modules"
    tag "modules_local"
    tag "dragen_cnv_qc"

    // Synthetic DRAGEN CNV output, see tests/fixtures/cnvqc/generate_cnvqc_fixtures.py.
    // The thresholds are set as pipeline params, so they reach the script through
    // conf/modules.config (ext.args), the same way as in a pipeline run.

    // rows of the R write.csv() output as maps (column -> value); splits on commas
    // outside double quotes and removes the quotes
    def readCsv = { file_path ->
        def lines = new File(file_path.toString()).readLines()
        def split = { line -> line.split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/).collect { field -> field.replaceAll(/^"|"$/, '') } }
        def header = split(lines[0])
        lines[1..-1].collect { line -> [ header, split(line) ].transpose().collectEntries() }
    }

    test("thresholds from params - purity, PMAD") {

        when {
            params {
                purity_min = "0.3"
                purity_max = "0.9"
                pmad_max   = "0.2"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/fixtures/cnvqc/dragen", checkIfExists: true)
                """
            }
        }

        then {
            // QC_STATUS and QC_FAIL_REASONS per sample from cnv-metrics.csv
            def qc = readCsv(process.out.metrics[0]).collectEntries { row -> [ row.sample, [ row.QC_STATUS, row.QC_FAIL_REASONS ] ] }
            assertAll(
                { assert process.success },
                { assert qc.CNVQC01 == [ 'PASS', 'none' ] },
                { assert qc.CNVQC02 == [ 'FAIL', 'EstimatedTumorPurity:0.25<0.3' ] },
                { assert qc.CNVQC03[0] == 'FAIL' },
                { assert qc.CNVQC03[1].contains('NoModelFound:EstimatedTumorPurity=NA') },
                { assert qc.CNVQC04 == [ 'FAIL', 'PMAD:0.35>0.2;EstimatedTumorPurity:0.95>0.9' ] },
                // purity exactly at purity_min passes
                { assert qc.CNVQC05 == [ 'PASS', 'none' ] },
                { assert process.out.plots[0].collect { plot -> file(plot).name }.sort().contains('karyoplot-CNVQC01-tn_mqc.png') },
                { assert snapshot(
                    process.out.metrics,
                    process.out.json
                ).match() }
            )
        }
    }

    test("no thresholds - only samples without a purity model fail") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/fixtures/cnvqc/dragen", checkIfExists: true)
                """
            }
        }

        then {
            def qc = readCsv(process.out.metrics[0]).collectEntries { row -> [ row.sample, row.QC_STATUS ] }
            assertAll(
                { assert process.success },
                { assert qc == [ CNVQC01: 'PASS', CNVQC02: 'PASS', CNVQC03: 'FAIL', CNVQC04: 'PASS', CNVQC05: 'PASS' ] }
            )
        }
    }

    test("error - purity_min given in percent") {

        when {
            params {
                purity_min = "40"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/fixtures/cnvqc/dragen", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.exitStatus == 1 },
                { assert (process.stdout + process.stderr).any { line -> line.contains('ERROR: Invalid purity_min=40. Must be in [0, 1].') } }
            )
        }
    }

    test("thresholds from params - stub") {

        options "-stub"

        when {
            params {
                purity_min = "0.3"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/fixtures/cnvqc/dragen", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // all declared outputs exist in a stub run
                { assert process.out.metrics.size() == 1 },
                { assert process.out.json.size() == 1 },
                { assert process.out.plots[0].size() == 4 }
            )
        }
    }
}
