process {
    withName: 'FINGERPRINT_QC' {
        ext.args = '--min-base-quality 20 --min-mapping-quality 20 --min-site-depth 10 --min-site-mean-base-quality 25 --min-fraction-passing-sites 0.5 --max-contamination 0.03 --qc-date 2026-01-01 --exomeqc-version 1.0.0'
        ext.prefix = { "${meta.id}_${meta.runid}.fingerprint_qc" }
    }
}
