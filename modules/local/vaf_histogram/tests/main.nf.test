nextflow_process {

    name "Test Process VAF_HISTOGRAM"
    script "../main.nf"
    process "VAF_HISTOGRAM"

    tag "modules"
    tag "modules_local"
    tag "vaf_histogram"

    // Synthetic VCFs, see tests/fixtures/vaf_histogram/generate_vaf_fixtures.py.
    // The options are set as pipeline params, so they reach the script through
    // conf/modules.config (ext.args), the same way as in a pipeline run.

    test("default params - 0.05 bins, all samples, PASS only") {

        when {
            process {
                """
                def fixtures = "${projectDir}/tests/fixtures/vaf_histogram/dragen"
                input[0] = [
                    file("\${fixtures}/VAFT01/VAFT01.hard-filtered.vcf.gz", checkIfExists: true),
                    file("\${fixtures}/VAFT02/VAFT02.hard-filtered.vcf.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            // non-empty bins of VAFT01-T: bin_start -> variants
            def rows = path(process.out.tsv[0]).readLines()[1..-1].collect { line -> line.split('\t') }
            def vaft01_t = rows.findAll { row -> row[0] == 'VAFT01-T' && row[4] != '0' }.collectEntries { row -> [ row[2], row[4] as int ] }
            assertAll(
                { assert process.success },
                { assert rows.size() == 4 * 20 },
                { assert vaft01_t == [ '0.10': 2, '0.15': 1, '0.20': 1, '0.40': 1, '0.50': 1, '0.95': 1 ] },
                { assert path(process.out.multiqc[0]).json.pconfig.data_labels.collect { label -> label.name } == [ 'VAFT01-N', 'VAFT01-T', 'VAFT02-N', 'VAFT02-T' ] },
                { assert snapshot(
                    process.out.tsv,
                    process.out.summary,
                    process.out.multiqc,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("tumor samples only, 0.1 bins, filtered records included") {

        when {
            params {
                vaf_histogram_bin_width        = 0.1
                vaf_histogram_sample_regex     = '-T$'
                vaf_histogram_include_filtered = true
            }
            process {
                """
                def fixtures = "${projectDir}/tests/fixtures/vaf_histogram/dragen"
                input[0] = [
                    file("\${fixtures}/VAFT01/VAFT01.hard-filtered.vcf.gz", checkIfExists: true),
                    file("\${fixtures}/VAFT02/VAFT02.hard-filtered.vcf.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines()[1..-1].collect { line -> line.split('\t') }
            def vaft01_t = rows.findAll { row -> row[0] == 'VAFT01-T' && row[4] != '0' }.collectEntries { row -> [ row[2], row[4] as int ] }
            assertAll(
                { assert process.success },
                { assert rows.collect { row -> row[0] }.unique() == [ 'VAFT01-T', 'VAFT02-T' ] },
                { assert rows.size() == 2 * 10 },
                // the weak_evidence record (AF 0.30) is counted
                { assert vaft01_t == [ '0.10': 3, '0.20': 1, '0.30': 1, '0.40': 1, '0.50': 1, '0.90': 1 ] }
            )
        }
    }

    test("error - sample regex matches no sample") {

        when {
            params {
                vaf_histogram_sample_regex = 'TUMOR$'
            }
            process {
                """
                input[0] = [ file("${projectDir}/tests/fixtures/vaf_histogram/dragen/VAFT01/VAFT01.hard-filtered.vcf.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.exitStatus == 1 },
                { assert (process.stdout + process.stderr).any { line -> line.contains("ERROR:") && line.contains("no sample matches --sample-regex 'TUMOR\$' (samples in the VCF: VAFT01-N, VAFT01-T)") } }
            )
        }
    }

    test("default params - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ file("${projectDir}/tests/fixtures/vaf_histogram/dragen/VAFT01/VAFT01.hard-filtered.vcf.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
