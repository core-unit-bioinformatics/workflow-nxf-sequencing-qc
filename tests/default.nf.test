nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                // conf/test.config uses paths relative to the repository root;
                // write the same samplesheet and MultiQC input list with absolute paths
                def fixtures = "${baseDir}/tests/fixtures/fingerprint"
                def samplesheet = new File("${outputDir}/samplesheet_test.csv")
                samplesheet.parentFile.mkdirs()
                samplesheet.text = new File("${fixtures}/samplesheet_test.csv").text
                    .replace('tests/fixtures/fingerprint/', "${fixtures}/")
                input = samplesheet.toString()
                def multiqc_inputs_file = new File("${outputDir}/multiqc_inputs_test.csv")
                multiqc_inputs_file.text = "paths\n${fixtures}/report\n"
                multiqc_inputs = multiqc_inputs_file.toString()
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*_multiqc_report_plots/**'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // MultiQC names its data directory after the report title
            def multiqc_data = new File("${params.outdir}/multiqc").listFiles().find { dir -> dir.name.endsWith('multiqc_report_data') }
            // heatmap LODs as sorted 'row column LOD' lines; Picard's sample order can differ between runs
            def heatmap_lines = path("${multiqc_data}/picard-crosscheckfingerprints-heatmap.txt").readLines()
            def heatmap_columns = heatmap_lines[0].split('\t')
            def heatmap = heatmap_lines[1..-1].collectMany { line ->
                def fields = line.split('\t')
                (1..<fields.size()).collect { i -> "${fields[0]} ${heatmap_columns[i]} ${fields[i]}".toString() }
            }.sort()
            assertAll(
                { assert workflow.success},
                // the database table of the report holds exactly the three cases of the fixture design
                { assert path("${params.outdir}/fingerprintcheck/database/fingerprint_database_matches.tsv").readLines().size() == 4 },
                // the Picard heatmap shows only this run's four samples (the database crosscheck is excluded)
                { assert path("${multiqc_data}/multiqc_sources.txt").readLines().findAll { line -> line.contains('crosscheck_metrics') }.every { line -> line.contains('crosscheck.crosscheck_metrics.txt') } },
                // the database section is in the report (custom content is not listed in multiqc_sources.txt)
                { assert new File("${multiqc_data}/multiqc_exomeqc_fingerprint_database_table.txt").exists() },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/exomeqc_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // crosscheck heatmap of this run's four samples
                    heatmap
                ).match() }
            )
        }
    }
}
