nextflow_pipeline {

    name "Test pipeline (SEQC2, needs scripts/download_seqc2_testdata.py --outdir testdata)"
    script "../main.nf"
    tag "pipeline"
    tag "seqc2"

    test("-profile test_seqc2") {

        when {
            params {
                outdir = "$outputDir"
                // SEQC2 test data in <repo>/testdata (scripts/download_seqc2_testdata.py --outdir testdata);
                // set explicitly because nf-test does not launch Nextflow from the repository root
                input                     = "${baseDir}/testdata/seqc2/samplesheet.csv"
                fastqscreen_database      = "${baseDir}/testdata/seqc2/fastqscreen_db.tar.gz"
                fingerprint_haplotype_map = "${baseDir}/testdata/seqc2/haplotype_map.txt"
                fasta                     = "${baseDir}/testdata/seqc2/reference.fasta"
                fasta_fai                 = "${baseDir}/testdata/seqc2/reference.fasta.fai"
                fasta_dict                = "${baseDir}/testdata/seqc2/reference.dict"
            }
        }

        then {
            // the updated database is named with the start time of the run
            def database_pattern = 'fingerprintcheck/database/exomeqc_fingerprint_database_*'
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/*_multiqc_report_plots/**', database_pattern])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Picard metrics hold a run date and work-dir paths: snapshot only the results
            def crosscheck = path("$outputDir/fingerprintcheck/crosscheck.crosscheck_metrics.txt").readLines()
                .findAll { line -> line && !line.startsWith('#') }
            def header = crosscheck[0].split('\t') as List
            def columns = ['LEFT_GROUP_VALUE', 'RIGHT_GROUP_VALUE', 'RESULT', 'LOD_SCORE', 'LOD_SCORE_TUMOR_NORMAL', 'LOD_SCORE_NORMAL_TUMOR']
                .collect { column -> header.indexOf(column) }
            def crosscheck_results = crosscheck.drop(1).collect { line ->
                def fields = line.split('\t')
                columns.collect { i -> fields[i].replaceAll(/.*\//, '') }.join('\t')
            }.sort() // BAM input order (and thus row order) is not deterministic
            def databases = new File("${params.outdir}/fingerprintcheck/database").listFiles().findAll { f -> f.name.startsWith('exomeqc_fingerprint_database_') }.collect { f -> f.name }.sort()
            def summary = path("${params.outdir}/fingerprintcheck/database/fingerprint_database_summary.tsv").readLines()
            // MultiQC names its data directory after the report title
            def multiqc_data = new File("${params.outdir}/multiqc").listFiles().find { dir -> dir.name.endsWith('multiqc_report_data') }
            def multiqc_report = new File("${params.outdir}/multiqc").listFiles().find { f -> f.name.endsWith('multiqc_report.html') }
            assert workflow.success
            assertAll(
                // one updated database with index, named exomeqc_fingerprint_database_<YYYYMMDD-hhmmss>
                { assert databases.size() == 2 },
                { assert databases[0] ==~ /exomeqc_fingerprint_database_\d{8}-\d{6}\.vcf\.gz/ },
                { assert databases[1] == "${databases[0]}.tbi".toString() },
                { assert summary.contains("updated_database_file\t${databases[0]}".toString()) },
                // the Picard heatmap shows only this run's crosscheck (a database crosscheck is excluded)
                { assert path("${multiqc_data}/multiqc_sources.txt").readLines().findAll { line -> line.contains('crosscheck_metrics') }.every { line -> line.contains('crosscheck.crosscheck_metrics.txt') } },
                // the overview section is in the report
                { assert multiqc_report.text.contains('Fingerprint check: overview') },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/exomeqc_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    // the fingerprint database summary without the timestamped database name
                    summary.findAll { line -> !line.startsWith('updated_database_file') },
                    // Fingerprint results (pair, RESULT, LOD scores)
                    crosscheck_results
                ).match() }
            )
        }
    }
}
